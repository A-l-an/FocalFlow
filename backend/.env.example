# Copy to .env locally and replace every placeholder before exporting values.
# FocalFlow does not load .env automatically; export the required variables.
# Chat endpoint is the complete chat-completions URL.
FOCALFLOW_CHAT_API_URL=https://chat.invalid/v1/chat/completions
FOCALFLOW_CHAT_API_TOKEN=REPLACE_WITH_YOUR_CHAT_TOKEN
DASHSCOPE_API_KEY=REPLACE_WITH_YOUR_DASHSCOPE_TOKEN
OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_TOKEN
# Required only when calling the legacy TTS function.
FOCALFLOW_LEGACY_TTS_API_URL=https://tts.invalid/v1/audio/speech
FOCALFLOW_LEGACY_TTS_API_TOKEN=REPLACE_WITH_YOUR_LEGACY_TTS_TOKEN
# The evaluation script also accepts FOCALFLOW_API_URL / FOCALFLOW_API_TOKEN.
# Those legacy variables take precedence over the CHAT variables if supplied.
